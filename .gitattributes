# План 13.1 (F4): при core.autocrlf=true свежий worktree выезжает с CRLF,
# и страж фикстур падает — fixtures/eval.jsonl получает \r\n, хеш не сходится.
# Страж наказывает за настройку git, а не за мутацию. Специфичные правила
# после общего (последнее совпадение выигрывает).
* text=auto
# Фикстуры — не текст: байты в git и на диске обязаны совпадать байт в байт.
fixtures/** -text
# sha256sums.txt читают и `sha256sum -c`, и scripts/check-fixtures.mjs (CRLF
# он терпит) — с LF он работает везде одинаково.
fixtures/sha256sums.txt text eol=lf
# Снапшоты vitest сравниваются с эталоном побайтово — LF на всех платформах.
*.snap text eol=lf
