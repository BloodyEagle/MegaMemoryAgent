// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildHelp — --db как глобальная опция (2.1.4) > снапшот текста хелпа 1`] = `
"megamemory v2.1.4 — persistent project knowledge graph for coding agents

Commands:
  (no command)    Start the MCP stdio server (invoked by your editor; global database/repository options apply)
  install         Configure integrations [--target NAME[,NAME...]]; default: interactive
  serve           Start the loopback-only web explorer [--port PORT] [--host HOST]; --db PATH
  stats           Show graph statistics [--prune] [--funnel] [--health] [--window 7d|30d|all] [--json]; --db PATH
  merge           Merge databases <FILE1> <FILE2> [--into FILE] [--left-label NAME] [--right-label NAME]
  conflicts       List unresolved merge conflicts [--json]; --db PATH
  resolve         Resolve a merge conflict <GROUP_ID> --keep left|right|both; --db PATH
  repair-ids      Fix legacy empty/trailing-slash node ids [--dry-run|--apply]; default: dry-run; --db PATH
  migrate         Upgrade an upstream v1.6.2 database [--dry-run|--apply]; default: dry-run; --db PATH
  reembed         Reindex node embeddings [--batch N]; default: 16; --db PATH
  consolidate     Find and merge near-duplicate nodes [--threshold RATIO] [--limit N] [--dry-run|--apply]; --db PATH
  digest          Rebuild derived digest nodes [--module ID] [--apply]; default: dry-run; --db PATH
  export          Export graph nodes to Markdown --md DIR [--check]; --db PATH
  doctor          Run database health checks (RW open; may migrate; exit 1 on problems; --db PATH)
  eval            Measure search recall@k [--file FILE] [--k N] [--min RATIO]; --db PATH
  guide           Print agent onboarding and worked-session guidance
                guide --workflow prints the full workflow contract (docs/agent-workflow.md, UTF-8, no database)
  bench           Measure graph orientation cost against files/TE --questions FILE [options]; --db PATH
  expire          Set valid_until on selected nodes (--ids IDS|--report FILE) --until DATE|past [--apply]; --db PATH

Global and MCP options:
  --db PATH       Path to knowledge.db (--db=PATH also accepted; then MEGAMEMORY_DB_PATH; default ./.megamemory/knowledge.db)
  --repo PATH     MCP startup repository for git:tag/commit/branch refs
                (--repo=PATH also accepted; default: database directory; repins git refs for this server)
  --help, -h      Show this help
  --version, -v   Show version

Command options:
  --target NAME[,NAME...]  install target(s), repeatable
                (opencode | claudecode | antigravity | codex; absent: interactive selection)
  --port PORT     serve port (default: 4321)
  --host HOST     serve address (default: 127.0.0.1; allowed: 127.0.0.1 or ::1)
  --prune         stats: apply timeline retention cleanup before reporting
  --funnel        stats: append the understand → follow-up → write funnel
  --health        stats: append honest health metrics (state now / activity window / completeness; never affects exit code)
  --window SPAN  stats --health/--funnel: same window for all requested sections (7d | 30d | all; default: 7d)
  --json          stats --funnel/--health: JSON-only without --prune; conflicts: machine-readable output
  --into FILE     merge output (default: overwrite FILE1 via a temporary file)
  --left-label NAME  merge source label (default: left)
  --right-label NAME merge source label (default: right)
  --keep SIDE     resolve strategy (required: left | right | both)
  --dry-run       repair-ids/migrate/consolidate: report without writing (default)
  --apply         repair-ids/migrate/consolidate: write changes; digest: build; expire: set dates
  --batch N       reembed batch size (leading positive base-10 integer; default: 16)
  --threshold RATIO consolidate cosine threshold (0..1; default: 0.95)
  --limit N       consolidate global output/apply pair cap (positive integer; default: 100; large groups also cap 50 pairs per node)
  --module ID     digest one parent id (default: every parent with at least 5 eligible children)
  --md DIR        export destination (required)
  --check         export: compare DIR with the current render and exit 1 on drift
  --file FILE     eval JSONL set (default: fixtures/eval.jsonl)
  --k N           eval recall cutoff (positive integer; default: 10)
  --min RATIO     eval pass threshold (0..1; default: 0.8)

Bench options:
  --questions FILE  JSONL questions (required; {"id"?,"query","expect_nodes"?,...})
  --baseline MODE baseline (files | te | both; default: files)
  --te-exec PROG  structured runner executable, spawned without a shell
  --te-arg ARG    structured runner argument, repeatable; one argument must contain {query}
                (requires --te-exec; default argv when omitted: {query})
  --te-cmd CMD    trusted shell template containing {query}; mutually exclusive with --te-exec
                (parsed by cmd.exe/sh, so shell quoting and environment expansion apply)
  --file-limit KB files over this size are token-estimated (default: 200)
  --ref-root PATH  extra root for relative file_refs, repeatable
                (first hit wins; order: question roots, --ref-root, git root, cwd)
  --files-top N   files baseline over the first N unique output files
                (default: 0 = all; 3 approximates a live agent; compare hit_rate@1 with hit_rate)

Expire options:
  --ids IDS       comma-separated node ids (mutually exclusive with --report)
  --report FILE   JSON report; use candidates whose expire field is true
  --until DATE|past parseable expiry date or yesterday (required)
  --apply         write expiry dates (default: dry-run)

Examples:
  $ megamemory install --target claudecode
  $ megamemory serve --port 8080 --host ::1
  $ megamemory stats --funnel --json --db ./knowledge.db
  $ megamemory merge main.db feature.db --into merged.db
  $ megamemory resolve <group-id> --keep left
  $ megamemory consolidate --threshold 0.95 --limit 100 --apply
  $ megamemory eval --file fixtures/eval.jsonl --k 10 --min 0.8
  $ megamemory bench --questions questions.jsonl --baseline files
  $ megamemory expire --ids a,b --until past --apply"
`;
